\@writefile{lof}{\contentsline {figure}{\numberline {3.5}{\ignorespaces  \textbf  {a)} Laser and atomic beam geometries with respect to the ion chain. \textbf  {b)} Compact trap housing with dual NA=0.6 access. The size of the high NA objectives restricts access for other beams, and so in-vacuum mirrors are used to redirect low-NA beams (373, 397, 423, 854, 866-nm) to the trap center. \textbf  {c)} Exploded view of the trap housing with components labelled. }}{23}{figure.caption.6}\protected@file@percent }
\newlabel{fig:trap_package}{{3.5}{23}{\textbf {a)} Laser and atomic beam geometries with respect to the ion chain. \textbf {b)} Compact trap housing with dual NA=0.6 access. The size of the high NA objectives restricts access for other beams, and so in-vacuum mirrors are used to redirect low-NA beams (373, 397, 423, 854, 866-nm) to the trap center. \textbf {c)} Exploded view of the trap housing with components labelled}{figure.caption.6}{}}
