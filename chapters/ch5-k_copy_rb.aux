\@writefile{lof}{\contentsline {figure}{\numberline {5.4}{\ignorespaces  Probing coherence of the mixed state after \emph  {k-copy} RB. Panel (a) shows a circuit that first twirls the state over $Cl_1^{\otimes 2}$, and then applies differential $\pi /2$-pulses with variable phase, $\phi $, to recover parity oscillations. Panel (b) shows the expected contrast of the oscillations as a function of sequence length when both local depolarising and \emph  {common noise} is present. The dashed lines indicate expected asymptotes for depolarising (blue) and for \emph  {common noise} (red). }}{96}{figure.caption.47}\protected@file@percent }
\newlabel{fig:parity_protocol}{{5.4}{96}{Probing coherence of the mixed state after \emph {k-copy} RB. Panel (a) shows a circuit that first twirls the state over $Cl_1^{\otimes 2}$, and then applies differential $\pi /2$-pulses with variable phase, $\phi $, to recover parity oscillations. Panel (b) shows the expected contrast of the oscillations as a function of sequence length when both local depolarising and \emph {common noise} is present. The dashed lines indicate expected asymptotes for depolarising (blue) and for \emph {common noise} (red)}{figure.caption.47}{}}
\newlabel{eqn:app_parcontrast}{{5.52}{96}{Parity contrast: an independent probe of coherence}{equation.5.4.52}{}}
\newlabel{eqn:parity_contrast}{{5.53}{96}{Parity contrast: an independent probe of coherence}{equation.5.4.53}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {5.5}{\ignorespaces  The performance of the \emph  {k-copy} fitting as a function of maximum Clifford sequence length (probe depth). Probe depth, $\gamma $, is relative to the characteristic decay length for the slowest mode, $\alpha _{tr}^m$. Panel (a) uses the Cram\'er-Rao derived relative uncertainty for each extracted $\varepsilon $, while (b) shows the minimum eigenvalue of the Fisher information matrix, with associated eigenvectors highlighted. }}{97}{figure.caption.48}\protected@file@percent }
\newlabel{fig:ch4_fisher_1}{{5.5}{97}{The performance of the \emph {k-copy} fitting as a function of maximum Clifford sequence length (probe depth). Probe depth, $\gamma $, is relative to the characteristic decay length for the slowest mode, $\alpha _{tr}^m$. Panel (a) uses the Cram\'er-Rao derived relative uncertainty for each extracted $\varepsilon $, while (b) shows the minimum eigenvalue of the Fisher information matrix, with associated eigenvectors highlighted}{figure.caption.48}{}}
