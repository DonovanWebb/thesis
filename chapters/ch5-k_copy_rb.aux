\@writefile{lof}{\contentsline {figure}{\numberline {5.1}{\ignorespaces  Circuit diagram for \emph  {k-copy} randomised benchmarking. A sequence of $m-1$ random Clifford gates are applied in parallel to $k$ qubits, with a final inverting Clifford applied to ideally recover the initial $\mathinner {|{0}\rangle }$ state. All qubits are measured, and correlations between qubits that successfully return to the initial state are recorded. }}{81}{figure.caption.38}\protected@file@percent }
\newlabel{fig:k-copy_circuit}{{5.1}{81}{Circuit diagram for \emph {k-copy} randomised benchmarking. A sequence of $m-1$ random Clifford gates are applied in parallel to $k$ qubits, with a final inverting Clifford applied to ideally recover the initial $\ket {0}$ state. All qubits are measured, and correlations between qubits that successfully return to the initial state are recorded}{figure.caption.38}{}}
