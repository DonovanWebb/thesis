\@writefile{lof}{\contentsline {figure}{\numberline {5.7}{\ignorespaces  Correlated two-qubit probabilities after \emph  {k-copy} RB. Panels (a,b) show the single-qubit success probabilities, which decay with a single exponential (solid line) toward $\mathcal  {P}_S|_{m\rightarrow \infty }=1/2$. Panel (c) shows the correlated two-qubit populations, which exhibit an intermediate $\mathcal  {P}_{SS}=1/3$ asymptote before relaxing toward $\mathcal  {P}_{SS}|_{m\rightarrow \infty }=1/4$. }}{102}{figure.caption.50}\protected@file@percent }
\newlabel{fig:k-copy_asymp}{{5.7}{102}{Correlated two-qubit probabilities after \emph {k-copy} RB. Panels (a,b) show the single-qubit success probabilities, which decay with a single exponential (solid line) toward $\mathcal {P}_S|_{m\rightarrow \infty }=1/2$. Panel (c) shows the correlated two-qubit populations, which exhibit an intermediate $\mathcal {P}_{SS}=1/3$ asymptote before relaxing toward $\mathcal {P}_{SS}|_{m\rightarrow \infty }=1/4$}{figure.caption.50}{}}
