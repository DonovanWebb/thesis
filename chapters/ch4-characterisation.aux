\@writefile{lot}{\contentsline {table}{\numberline {4.3}{\ignorespaces  *729-nm detuning is relative to the $\mathinner {|{4S_{1/2},~m_j=-1/2}\rangle } \leftrightarrow \mathinner {|{3D_{5/2},~m_j=-5/2}\rangle }$ transition frequency.  Experimental parameters used for sideband cooling. Other parameters for the repump and deshelve pulses are the same as for state preparation, see table~\ref {tab:state_prep_parameters}. The 729-nm laser is detuned to the RSB resonance for the upper radial mode, $\omega _{\rm  upper}/2\pi = 4.0$~\unit {\MHz }, and the pulse duration for $N=N_{\rm  max}$ is chosen to be the expected RSB $R(\pi )$-pulse duration for $n=1$. }}{59}{table.caption.31}\protected@file@percent }
\newlabel{tab:sbc_parameters}{{4.3}{59}{*729-nm detuning is relative to the $\ket {4S_{1/2},~m_j=-1/2} \leftrightarrow \ket {3D_{5/2},~m_j=-5/2}$ transition frequency.\\ Experimental parameters used for sideband cooling. Other parameters for the repump and deshelve pulses are the same as for state preparation, see table~\ref {tab:state_prep_parameters}. The 729-nm laser is detuned to the RSB resonance for the upper radial mode, $\omega _{\rm upper}/2\pi = 4.0$~\unit {\MHz }, and the pulse duration for $N=N_{\rm max}$ is chosen to be the expected RSB $R(\pi )$-pulse duration for $n=1$}{table.caption.31}{}}
\@writefile{toc}{\contentsline {subsubsection}{Sideband Cooling}{59}{section*.29}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {4.8}{\ignorespaces  \textbf  {a)} Example pulse sequence for one experimental shot including pulsed sideband cooling. The \emph  {Exp.} block represents an arbitrary sequence of operations, for the experiment under study, such as a thermometry sequence. The blue blocks represent Doppler cooling and readout (section~\ref {sec:Measurement}), the green blocks represent qubit state preparation (section~\ref {sec:Stateprep}), the red blocks are RSB pulses with varying durations $t(N)$, and the purple blocks are deshelving pulses. After every 5 sideband cooling pulses, there is an interleaved state preparation sequence to ensure there is no population trapped outside of the closed cooling cycle. The RSB length is linearly increased with pulse number $N$, upto the expected RSB $R(\pi )$-pulse duration for $n=1$. \textbf  {b, c)} Thermometry scans after Doppler and sideband cooling. The red points are the populations measured via on-resonance RSB pulses, and the blue points are the populations after a sequence of $R(\pi )$-RSB-$R(\pi )$ with varying RSB probe durations. The dashed lines are fits to a thermal Fock state distribution, with truncation at $n = 100$. The extracted mean occupation number is $\bar  {n} = 0.03(1)$, and $\eta \Omega /(2\pi ) = 11.6(1)$~\unit {\kHz }. }}{60}{figure.caption.30}\protected@file@percent }
\newlabel{fig:SBC}{{4.8}{60}{\textbf {a)} Example pulse sequence for one experimental shot including pulsed sideband cooling. The \emph {Exp.} block represents an arbitrary sequence of operations, for the experiment under study, such as a thermometry sequence. The blue blocks represent Doppler cooling and readout (section~\ref {sec:Measurement}), the green blocks represent qubit state preparation (section~\ref {sec:Stateprep}), the red blocks are RSB pulses with varying durations $t(N)$, and the purple blocks are deshelving pulses. After every 5 sideband cooling pulses, there is an interleaved state preparation sequence to ensure there is no population trapped outside of the closed cooling cycle. The RSB length is linearly increased with pulse number $N$, upto the expected RSB $R(\pi )$-pulse duration for $n=1$. \textbf {b, c)} Thermometry scans after Doppler and sideband cooling. The red points are the populations measured via on-resonance RSB pulses, and the blue points are the populations after a sequence of $R(\pi )$-RSB-$R(\pi )$ with varying RSB probe durations. The dashed lines are fits to a thermal Fock state distribution, with truncation at $n = 100$. The extracted mean occupation number is $\bar {n} = 0.03(1)$, and $\eta \Omega /(2\pi ) = 11.6(1)$~\unit {\kHz }}{figure.caption.30}{}}
