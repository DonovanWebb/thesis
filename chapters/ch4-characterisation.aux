\@writefile{lof}{\contentsline {figure}{\numberline {4.13}{\ignorespaces  Experimental data for $\mathcal  {F}=92(2)$\% Mølmer-Sørensen (MS) two-qubit entangling gate. \textbf  {a)} Populations versus duration scan of the MS interaction. Each point corresponds to the average of 200 shots, and the error bars are given by the standard deviation of these averages. The blue points are the populations of both ions being in the $\mathinner {|{0}\rangle }$ state, $P_{00}$, the green points are the populations of both ions being in the $\mathinner {|{1}\rangle }$ state, $P_{11}$, and the red points are the ions being the the opposite states, $(P_{01}+P_{10})/2$. The desired entangling gate corresponds here to $t_g = 75$\unit {\us }. \textbf  {b)} Parity oscillations after the MS interaction. The parity is defined as $P_{00} + P_{11} - P_{01} - P_{10}$. The fitted contrast here is $0.90(2)$. \textbf  {c)} Populations at the desired entangling gate duration, $t_g = 75$~\unit {us}. }}{71}{figure.caption.37}\protected@file@percent }
\newlabel{fig:ms_gate}{{4.13}{71}{Experimental data for $\mathcal {F}=92(2)$\% Mølmer-Sørensen (MS) two-qubit entangling gate. \textbf {a)} Populations versus duration scan of the MS interaction. Each point corresponds to the average of 200 shots, and the error bars are given by the standard deviation of these averages. The blue points are the populations of both ions being in the $\ket {0}$ state, $P_{00}$, the green points are the populations of both ions being in the $\ket {1}$ state, $P_{11}$, and the red points are the ions being the the opposite states, $(P_{01}+P_{10})/2$. The desired entangling gate corresponds here to $t_g = 75$\unit {\us }. \textbf {b)} Parity oscillations after the MS interaction. The parity is defined as $P_{00} + P_{11} - P_{01} - P_{10}$. The fitted contrast here is $0.90(2)$. \textbf {c)} Populations at the desired entangling gate duration, $t_g = 75$~\unit {us}}{figure.caption.37}{}}
\newlabel{eq:Fidelity}{{4.8}{72}{Two-Qubit Entangling Gates}{equation.4.4.8}{}}
