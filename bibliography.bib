@misc{hughes_trapped-ion_2025,
	title = {Trapped-ion two-qubit gates with {\textgreater}99.99\% fidelity without ground-state cooling},
	url = {http://arxiv.org/abs/2510.17286},
	doi = {10.48550/arXiv.2510.17286},
	abstract = {We introduce the 'smooth gate', an entangling method for trapped-ion qubits where residual spin-motion entanglement errors are adiabatically eliminated by ramping the gate detuning. We demonstrate electronically controlled two-qubit gates with an estimated error of \$8.4(7){\textbackslash}times10{\textasciicircum}\{-5\}\$ without ground-state cooling. We further show that the error remains \${\textbackslash}lesssim 5{\textbackslash}times10{\textasciicircum}\{-4\}\$ for ions with average phonon occupation up to \${\textbackslash}bar\{n\}=9.4(3)\$ on the gate mode. These results indicate that trapped-ion quantum computation can achieve high fidelity at temperatures above the Doppler limit, which enables faster and simpler device operation.},
	urldate = {2026-05-04},
	publisher = {arXiv},
	author = {Hughes, A. C. and Srinivas, R. and Löschnauer, C. M. and Knaack, H. M. and Matt, R. and Ballance, C. J. and Malinowski, M. and Harty, T. P. and Sutherland, R. T.},
