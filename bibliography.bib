@incollection{nagourney_optical_2014-1,
	title = {Optical resonators – geometrical properties},
	isbn = {978-0-19-966548-8},
	url = {https://doi.org/10.1093/acprof:oso/9780199665488.003.0002},
	abstract = {Optical resonator geometrical properties – those depending only on the cavity geometry and wavelength of the radiation – are derived for both standing-wave and traveling-wave cavities. Cavity eigenmodes, cavity resonant frequencies and mode-matching into the cavity are discussed. In order to treat the higher-order cavity modes, the complete set of solutions (the Hermite-Gaussian functions) to the paraxial wave equation are described. The aberration of astigmatism – present to some degree in all traveling-wave cavities – is considered in some detail, and expressions for the astigmatism due to off-axis reflection from a curved mirror and off-axis incidence on a transparent crystal are provided. Finally, the M2 parameter, which characterizes beam quality, is introduced.},
