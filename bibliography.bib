	month = nov,
	year = {2023},
	note = {arXiv:2211.07320 [quant-ph]},
	keywords = {Quantum Physics},
	pages = {1503--1508},
	file = {Valahu et al. - 2023 - Direct observation of geometric phase in dynamics .pdf:C\:\\Users\\webbd\\Zotero\\storage\\XFCLZE2F\\Valahu et al. - 2023 - Direct observation of geometric phase in dynamics .pdf:application/pdf},
}

