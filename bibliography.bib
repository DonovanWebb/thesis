}

@incollection{nagourney_optical_2014,
	title = {Optical cavity as frequency discriminator},
	isbn = {978-0-19-966548-8},
	url = {https://doi.org/10.1093/acprof:oso/9780199665488.003.0004},
	abstract = {Two techniques for generating an optical discriminant using a cavity are discussed in detail: the Pound–Drever–Hall (PDH) scheme, which uses a frequency-modulated signal reflected from a cavity, and the passive polarization scheme, which analyzes the polarization of the reflected signal from a cavity containing a polarizing element. The use of a cavity in transmission is briefly discussed, and the principles are first illustrated with a simple “quick and dirty” approach for generating a discriminant using a length-modulated cavity and phase-sensitive detection. The chapter concludes with a derivation of the frequency response of the discriminator to a frequency-modulated laser beam – results which are important when analyzing the servomechanism aspects of a laser which is frequency-locked to a cavity.},
