@incollection{nagourney_descriptions_2014,
	title = {Descriptions of specific {CW} laser systems},
	isbn = {978-0-19-966548-8},
	url = {https://doi.org/10.1093/acprof:oso/9780199665488.003.0007},
	abstract = {In this chapter, several continuous-wave laser systems are described, aided by the theory formulated in the previous two chapters. (Due to its dominance, the ubiquitous diode laser warrants at least one chapter of its own, and is not discussed in this chapter.) Argon-ion lasers and dye/Ti–sapphire lasers are discussed in some detail, and some commercial realizations of these lasers are described. The diode-pumped frequency-doubled Nd:YVO4 laser and the Ti–sapphire laser (pumped by the former) are discussed. Finally, the formerly ubiquitous He–Ne laser (currently supplanted by red diode lasers) are described – in part for historical reasons, and also because it employs an interesting and unique excitation transfer mechanism for pumping.},
