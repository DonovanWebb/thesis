	file = {Preprint PDF:C\:\\Users\\webbd\\Zotero\\storage\\3CBDGBEM\\Havel and Doran - 2004 - A Bloch-Sphere-Type Model for Two Qubits in the Ge.pdf:application/pdf;Snapshot:C\:\\Users\\webbd\\Zotero\\storage\\PIVYAQWS\\0403136.html:text/html},
