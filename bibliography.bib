@incollection{nagourney_semiconductor_2014,
	title = {Semiconductor diode lasers},
	isbn = {978-0-19-966548-8},
	url = {https://doi.org/10.1093/acprof:oso/9780199665488.003.0009},
	abstract = {This chapter describes some specific semiconductor lasers and discusses their characteristics. The discussion proceeds in historical order, starting with the homojunction laser and introducing each new development up to the strained-junction quantum-well laser. Longitudinal mode control with distributed feedback and Bragg reflector lasers, and the more experimentally ubiquitous external cavity-diode laser, are described, and the properties of all of these lasers are discussed in some detail. In particular, the rate equations for the photon number, electric field phase and carrier density are derived and used to describe relaxation oscillations and the frequency modulation characteristics of diode lasers. The chapter ends with a description of semiconductor laser amplifiers and injection-locked diode lasers.},
