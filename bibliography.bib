@article{brewer_27mathrm_2019,
	title = {\${\textasciicircum}\{27\}\{{\textbackslash}mathrm\{{Al}\}\}{\textasciicircum}\{+\}\$ {Quantum}-{Logic} {Clock} with a {Systematic} {Uncertainty} below \$\{10\}{\textasciicircum}\{{\textbackslash}ensuremath\{-\}18\}\$},
