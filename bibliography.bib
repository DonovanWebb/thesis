	url = {https://arxiv.org/abs/2111.14907v1},
	abstract = {We study the distribution over measurement outcomes of noisy random quantum circuits in the low-fidelity regime. We show that, for local noise that is sufficiently weak and unital, correlations (measured by the linear cross-entropy benchmark) between the output distribution \$p\_\{{\textbackslash}text\{noisy\}\}\$ of a generic noisy circuit instance and the output distribution \$p\_\{{\textbackslash}text\{ideal\}\}\$ of the corresponding noiseless instance shrink exponentially with the expected number of gate-level errors, as \$F={\textbackslash}text\{exp\}(-2s{\textbackslash}epsilon {\textbackslash}pm O(s{\textbackslash}epsilon{\textasciicircum}2))\$, where \${\textbackslash}epsilon\$ is the probability of error per circuit location and \$s\$ is the number of two-qubit gates. Furthermore, if the noise is incoherent, the output distribution approaches the uniform distribution \$p\_\{{\textbackslash}text\{unif\}\}\$ at precisely the same rate and can be approximated as \$p\_\{{\textbackslash}text\{noisy\}\} {\textbackslash}approx Fp\_\{{\textbackslash}text\{ideal\}\} + (1-F)p\_\{{\textbackslash}text\{unif\}\}\$, that is, local errors are scrambled by the random quantum circuit and contribute only white noise (uniform output). Importantly, we upper bound the total variation error (averaged over random circuit instance) in this approximation as \$O(F{\textbackslash}epsilon {\textbackslash}sqrt\{s\})\$, so the "white-noise approximation" is meaningful when \${\textbackslash}epsilon {\textbackslash}sqrt\{s\} {\textbackslash}ll 1\$, a quadratically weaker condition than the \${\textbackslash}epsilon s{\textbackslash}ll 1\$ requirement to maintain high fidelity. The bound applies when the circuit size satisfies \$s {\textbackslash}geq {\textbackslash}Omega(n{\textbackslash}log(n))\$ and the inverse error rate satisfies \${\textbackslash}epsilon{\textasciicircum}\{-1\} {\textbackslash}geq {\textbackslash}tilde\{{\textbackslash}Omega\}(n)\$. The white-noise approximation is useful for salvaging the signal from a noisy quantum computation; it was an underlying assumption in complexity-theoretic arguments that low-fidelity random quantum circuits cannot be efficiently sampled classically. Our method is based on a map from second-moment quantities in random quantum circuits to expectation values of certain stochastic processes for which we compute upper and lower bounds.},
	language = {en},
	urldate = {2026-06-01},
	journal = {arXiv.org},
	author = {Dalzell, Alexander M. and Hunter-Jones, Nicholas and Brandão, Fernando G. S. L.},
