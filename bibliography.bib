@article{wang_effect_2025,
	title = {Effect of multiqubit correlated noise on surface-code thresholds},
	volume = {112},
	url = {https://link.aps.org/doi/10.1103/hjqn-lyh2},
	doi = {10.1103/hjqn-lyh2},
	abstract = {Surface codes are promising for practical quantum error correction due to their high threshold and experimental feasibility. However, their performance under realistic noise conditions, particularly those involving correlated errors, requires further investigation. In this study, we systematically investigate the effect of several distinct types of correlated errors that could potentially arise from next-nearest-neighbor coupling in quantum systems. Our analytical results reveal that these correlated errors exhibit lower logical error rates due to their inherent structural symmetries. We further perform circuit-level simulations that incorporate realistic circuit level errors alongside correlated noise components, demonstrating that surface code performance is intimately related to the structural characteristics of the correlation patterns. This deepens our insights into the threshold of surface code and hence facilitates a more robust design of quantum circuits with a higher noise threshold.},
	number = {6},
	urldate = {2026-03-26},
	journal = {Phys. Rev. A},
