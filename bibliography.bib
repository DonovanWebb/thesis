	abstract = {We present a novel protocol for high-fidelity qubit state preparation and measurement (SPAM) that combines standard SPAM methods with a series of in-sequence measurements to detect and remove errors. The protocol can be applied in any quantum system with a long-lived (metastable) level and a means to detect population outside of this level without coupling to it. We demonstrate the use of the protocol for three different qubit encodings in a single trapped \${\textasciicircum}\{137\}{\textbackslash}mathrm\{Ba\}{\textasciicircum}+\$ ion. For all three, we achieve the lowest reported SPAM infidelities of \$7(4) {\textbackslash}times 10{\textasciicircum}\{-6\}\$ (optical qubit), \$5(4) {\textbackslash}times 10{\textasciicircum}\{-6\}\$ (metastable-level qubit), and \$8(4) {\textbackslash}times 10{\textasciicircum}\{-6\}\$ (ground-level qubit).},
	urldate = {2025-05-31},
	publisher = {arXiv},
	author = {Sotirova, A. S. and Leppard, J. D. and Vazquez-Brennan, A. and Decoppet, S. M. and Pokorny, F. and Malinowski, M. and Ballance, C. J.},
	month = sep,
