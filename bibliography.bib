	title = {Experimental realization of entangled coherent states in two-dimensional harmonic oscillators of a trapped ion},
	volume = {14},
	copyright = {2024 The Author(s)},
	issn = {2045-2322},
	url = {https://www.nature.com/articles/s41598-024-57391-6},
