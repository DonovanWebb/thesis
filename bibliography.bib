@incollection{nagourney_laser_2014-1,
	title = {Laser gain in a semiconductor},
	isbn = {978-0-19-966548-8},
	url = {https://doi.org/10.1093/acprof:oso/9780199665488.003.0008},
	abstract = {The theory of semiconductor laser gain is presented. The most important results of the solid-state physics of semiconductors is presented first, as a background, using the helpful one-dimensional Kronig–Penny model to explain the “band theory” and the Bohr model to describe the behavior of the electrons in doped semiconductors. The concept of “equivalent mass” is introduced, and an explanation for the rectifying property of a p–n junction is provided. The use of quasi-Fermi levels to describe the electron distributions in the conduction and valence bands of a direct semiconductor is described, and the optical gain of the material under current injection is derived.},
	urldate = {2023-08-25},
	booktitle = {Quantum {Electronics} for {Atomic} {Physics} and {Telecommunication}},
	publisher = {Oxford University Press},
