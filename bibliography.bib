@article{zhang_error-mitigated_2020,
	title = {Error-mitigated quantum gates exceeding physical fidelities in a trapped-ion system},
	volume = {11},
	copyright = {2020 The Author(s)},
	issn = {2041-1723},
	url = {https://www.nature.com/articles/s41467-020-14376-z},
	doi = {10.1038/s41467-020-14376-z},
	abstract = {Various quantum applications can be reduced to estimating expectation values, which are inevitably deviated by operational and environmental errors. Although errors can be tackled by quantum error correction, the overheads are far from being affordable for near-term technologies. To alleviate the detrimental effects of errors on the estimation of expectation values, quantum error mitigation techniques have been proposed, which require no additional qubit resources. Here we benchmark the performance of a quantum error mitigation technique based on probabilistic error cancellation in a trapped-ion system. Our results clearly show that effective gate fidelities exceed physical fidelities, i.e., we surpass the break-even point of eliminating gate errors, by programming quantum circuits. The error rates are effectively reduced from (1.10 ± 0.12) × 10−3 to (1.44 ± 5.28) × 10−5 and from (0.99 ± 0.06) × 10−2 to (0.96 ± 0.10) × 10−3 for single- and two-qubit gates, respectively. Our demonstration opens up the possibility of implementing high-fidelity computations on a near-term noisy quantum device.},
	language = {en},
	number = {1},
	urldate = {2026-04-30},
	journal = {Nat Commun},
	publisher = {Nature Publishing Group},
	author = {Zhang, Shuaining and Lu, Yao and Zhang, Kuan and Chen, Wentao and Li, Ying and Zhang, Jing-Ning and Kim, Kihwan},
	month = jan,
	year = {2020},
	keywords = {Quantum information, Quantum optics, Quantum simulation, Information theory and computation},
	pages = {587},
	file = {Full Text PDF:C\:\\Users\\webbd\\Zotero\\storage\\BTYLK4NE\\Zhang et al. - 2020 - Error-mitigated quantum gates exceeding physical f.pdf:application/pdf},
}

@misc{evered_high-fidelity_2026,
	title = {High-fidelity entangling gates and nonlocal circuits with neutral atoms},
	url = {http://arxiv.org/abs/2604.25987},
	doi = {10.48550/arXiv.2604.25987},
	abstract = {Creation and manipulation of entanglement with low error is essential in quantum information systems. In practice, two-qubit entangling gates constitute a dominant error source, limiting circuit depths and performance in fault-tolerant architectures. Using a neutral-atom quantum processor, we realize entangling CZ gates with a high Rabi frequency smooth-amplitude pulse, employing state-selective readout and qubit reuse for fast calibration, and achieve state-of-the-art fidelities of 99.854(4)\% which improve to 99.941(3)\% upon loss postselection, with stable performance for 10 hours. We then use these low-error gates in quantum circuits with coherent atom rearrangement. We first benchmark performance by creating and disentangling cluster states, and subsequently implement scrambling circuits featuring longer-range connectivity to study non-locally entangled states generated through chaotic dynamics. These results pave the way towards deep-circuit, efficient fault-tolerant quantum computation.},
	urldate = {2026-05-04},
	publisher = {arXiv},
	author = {Evered, Simon J. and Xu, Muqing and Li, Sophie H. and Geim, Alexandra A. and Ataides, J. Pablo Bonilla and Kalinowski, Marcin and Bluvstein, Dolev and Maskara, Nishad and Kokail, Christian and Greiner, Markus and Vuletić, Vladan and Lukin, Mikhail D.},
	month = apr,
	year = {2026},
	note = {arXiv:2604.25987 [quant-ph]},
	keywords = {Quantum Physics, Physics - Atomic Physics},
	file = {Evered et al. - 2026 - High-fidelity entangling gates and nonlocal circui.pdf:C\:\\Users\\webbd\\Zotero\\storage\\BU828LXD\\Evered et al. - 2026 - High-fidelity entangling gates and nonlocal circui.pdf:application/pdf;Preprint PDF:C\:\\Users\\webbd\\Zotero\\storage\\K5YD4G2I\\Evered et al. - 2026 - High-fidelity entangling gates and nonlocal circui.pdf:application/pdf;Snapshot:C\:\\Users\\webbd\\Zotero\\storage\\E4FM7MKL\\2604.html:text/html},
}

