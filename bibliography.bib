	keywords = {Quantum Physics},
	file = {Kwiatkowski et al. - 2023 - Optimized experiment design and analysis for fully.pdf:C\:\\Users\\webbd\\Zotero\\storage\\E7R8UBMH\\Kwiatkowski et al. - 2023 - Optimized experiment design and analysis for fully.pdf:application/pdf},
