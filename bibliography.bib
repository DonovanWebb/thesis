	note = {Number: 9},
	keywords = {Quantum information, Nanometrology},
	pages = {572--576},
	file = {Full Text PDF:C\:\\Users\\webbd\\Zotero\\storage\\C6SBV3B3\\Wilpers et al. - 2012 - A monolithic array of three-dimensional ion traps .pdf:application/pdf},
}

