	month = mar,
	year = {2024},
	keywords = {Quantum information, Qubits, Quantum optics},
	pages = {2512},
	file = {Full Text PDF:C\:\\Users\\webbd\\Zotero\\storage\\4I3EC8CR\\Eriksson et al. - 2024 - Universal control of a bosonic mode via drive-acti.pdf:application/pdf},
}

