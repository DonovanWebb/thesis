@misc{saner_breaking_2023-1,
	title = {Breaking the entangling gate speed limit for trapped-ion qubits using a phase-stable standing wave},
	url = {http://arxiv.org/abs/2305.03450},
	abstract = {All laser-driven entangling operations for trapped-ion qubits have hitherto been performed without control of the optical phase of the light field, which precludes independent tuning of the carrier and motional coupling. By placing \${\textasciicircum}\{88\}\$Sr\${\textasciicircum}+\$ ions in a \${\textbackslash}lambda=674\$ nm standing wave, whose relative position is controlled to \${\textbackslash}approx{\textbackslash}lambda/100\$, we suppress the carrier coupling by a factor of \$18\$, while coherently enhancing the spin-motion coupling. We experimentally demonstrate that the off-resonant carrier coupling imposes a speed limit for conventional traveling-wave M\{{\textbackslash}o\}lmer-S\{{\textbackslash}o\}rensen gates; we use the standing wave to surpass this limit and achieve a gate duration of \$15{\textbackslash} {\textbackslash}mu\$s, restricted by the available laser power.},
	language = {en},
	urldate = {2023-06-26},
	publisher = {arXiv},
	author = {Saner, S. and Băzăvan, O. and Minder, M. and Drmota, P. and Webb, D. J. and Araneda, G. and Srinivas, R. and Lucas, D. M. and Ballance, C. J.},
	month = may,
	year = {2023},
	note = {arXiv:2305.03450 [physics, physics:quant-ph]},
	keywords = {Quantum Physics, Physics - Atomic Physics},
	file = {Saner et al. - 2023 - Breaking the entangling gate speed limit for trapp.pdf:C\:\\Users\\webbd\\Zotero\\storage\\UXCEPJU6\\Saner et al. - 2023 - Breaking the entangling gate speed limit for trapp.pdf:application/pdf},
}

