@article{merkel_magnetic_2019,
	title = {Magnetic field stabilization system for atomic physics experiments},
	volume = {90},
	issn = {0034-6748, 1089-7623},
	url = {http://arxiv.org/abs/1808.03310},
	doi = {10.1063/1.5080093},
	abstract = {Atomic physics experiments commonly use millitesla-scale magnetic fields to provide a quantization axis. As atomic transition frequencies depend on the amplitude of this field, many experiments require a stable absolute field. Most setups use electromagnets, which require a power supply stability not usually met by commercially available units. We demonstrate stabilization of a field of 14.6 mT to 4.3 nT rms noise (0.29 ppm), compared to noise of \${\textbackslash}gtrsim\$ 100 nT without any stabilization. The rms noise is measured using a field-dependent hyperfine transition in a single \${\textasciicircum}\{43\}\$Ca\${\textasciicircum}+\$ ion held in a Paul trap at the centre of the magnetic field coils. For the \${\textasciicircum}\{43\}\$Ca\${\textasciicircum}+\$ "atomic clock" qubit transition at 14.6 mT, which depends on the field only in second order, this would yield a projected coherence time of many hours. Our system consists of a feedback loop and a feedforward circuit that control the current through the field coils and could easily be adapted to other field amplitudes, making it suitable for other applications such as neutral atom traps.},
	language = {en},
	number = {4},
	urldate = {2023-09-13},
	journal = {Review of Scientific Instruments},
	author = {Merkel, B. and Thirumalai, K. and Tarlton, J. E. and Schäfer, V. M. and Ballance, C. J. and Harty, T. P. and Lucas, D. M.},
	month = apr,
	year = {2019},
	note = {arXiv:1808.03310 [physics, physics:quant-ph]},
	keywords = {Quantum Physics, Physics - Atomic Physics, Physics - Instrumentation and Detectors},
	pages = {044702},
	file = {Merkel et al. - 2019 - Magnetic field stabilization system for atomic phy.pdf:C\:\\Users\\webbd\\Zotero\\storage\\7C9LE5RI\\Merkel et al. - 2019 - Magnetic field stabilization system for atomic phy.pdf:application/pdf},
}

