}

@misc{burd_experimental_2023,
	title = {Experimental speedup of quantum dynamics through squeezing},
	url = {http://arxiv.org/abs/2304.05529},
	abstract = {We show experimentally that a broad class of interactions involving quantum harmonic oscillators can be made stronger (amplified) using a unitary squeezing protocol. While our demonstration uses the motional and spin states of a single trapped \${\textasciicircum}\{25\}\$Mg\${\textasciicircum}\{+\}\$ ion, the scheme applies generally to Hamiltonians involving just a single harmonic oscillator as well as Hamiltonians coupling the oscillator to another quantum degree of freedom such as a qubit, covering a large range of systems of interest in quantum information and metrology applications. Importantly, the protocol does not require knowledge of the parameters of the Hamiltonian to be amplified, nor does it require a well-defined phase relationship between the squeezing interaction and the rest of the system dynamics, making it potentially useful in instances where certain aspects of a signal or interaction may be unknown or uncontrolled.},
	language = {en},
	urldate = {2024-01-30},
	publisher = {arXiv},
	author = {Burd, S. C. and Knaack, H. M. and Srinivas, R. and Arenz, C. and Collopy, A. L. and Stephenson, L. J. and Wilson, A. C. and Wineland, D. J. and Leibfried, D. and Bollinger, J. J. and Allcock, D. T. C. and Slichter, D. H.},
	month = apr,
	year = {2023},
	note = {arXiv:2304.05529 [physics, physics:quant-ph]},
	keywords = {Quantum Physics, Physics - Atomic Physics},
	file = {Burd et al. - 2023 - Experimental speedup of quantum dynamics through s.pdf:C\:\\Users\\webbd\\Zotero\\storage\\GZWTULFI\\Burd et al. - 2023 - Experimental speedup of quantum dynamics through s.pdf:application/pdf},
}

