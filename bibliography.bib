	keywords = {Quantum Physics, Condensed Matter - Quantum Gases, High Energy Physics - Lattice},
	file = {Băzăvan et al. - 2023 - Synthetic \$mathbb Z _2\$ gauge theories based on p.pdf:C\:\\Users\\webbd\\Zotero\\storage\\W6HU4ZPT\\Băzăvan et al. - 2023 - Synthetic \$mathbb Z _2\$ gauge theories based on p.pdf:application/pdf},
