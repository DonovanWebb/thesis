@article{ramm_precision_2013,
	title = {Precision {Measurement} {Method} for {Branching} {Fractions} of {Excited} \$\{{P}\}\_\{1/2\}\$ {States} {Applied} to \${\textasciicircum}\{40\}{\textbackslash}mathrm\{{Ca}\}{\textasciicircum}\{{\textbackslash}mathbf\{+\}\}\$},
