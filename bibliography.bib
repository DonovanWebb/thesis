@misc{mallweger_single-shot_2023,
	title = {Single-shot measurements of phonon number states using the {Autler}-{Townes} effect},
	url = {http://arxiv.org/abs/2302.03553},
	abstract = {We present a single-shot method to measure motional states in the number basis. The technique can be applied to systems with at least three non-degenerate energy levels which can be coupled to a linear quantum harmonic oscillator, such as in trapped ion experiments. The method relies on probing an Autler-Townes splitting that arises when two levels are strongly coupled via a phonon-number changing transition. We demonstrate the method using a single trapped ion and show that it may be used in a non-demolition fashion to prepare phonon number states. We also show how the Autler-Townes splitting can be used to measure phonon number distributions.},
	language = {en},
	urldate = {2023-07-04},
	publisher = {arXiv},
	author = {Mallweger, Marion and de Oliveira, Murilo Henrique and Thomm, Robin and Parke, Harry and Kuk, Natalia and Higgins, Gerard and Bachelard, Romain and Villas-Boas, Celso Jorge and Hennrich, Markus},
	month = feb,
	year = {2023},
	note = {arXiv:2302.03553 [quant-ph]},
	keywords = {Quantum Physics},
	file = {Mallweger et al. - 2023 - Single-shot measurements of phonon number states u.pdf:C\:\\Users\\webbd\\Zotero\\storage\\DHB2PH6U\\Mallweger et al. - 2023 - Single-shot measurements of phonon number states u.pdf:application/pdf},
}

@article{rickert_simultaneous_nodate,
	title = {Simultaneous and individual ion addressing for quantum information processing},
	abstract = {For fault tolerant quantum computing it is necessary to perform a series of quantum gates on a register of qubits in a short period of time. In the case of an ion trap quantum computer these gates are implemented by shining laser beams onto the ions in a controlled way. This thesis deals with the development and implementation of a novel setup for single ion addressing, which enables simultaneous and individual manipulation of the ions. The new setup makes use of ﬁbre beamsplitters for multiplexing the addressing laser and ﬁbre AOMs for altering each beam individually. A micro-mirror array is utilised to point each beam to a single ion. The optics needed to focus the beams onto individual ions is simulated and investigated in a test setup. The most promising of the simulated setups, which is expected to be able to address up to four ions, is implemented into the experiment. The waist of the central addressing beam in this setup is measured to be w0 = 1.52(5) µm. For future experiments, simulations with another objective with NA {\textasciitilde} 0.8 are performed, which indicate addressability of up to 19 ions.},
	language = {en},
	author = {Rickert, Julian},
	file = {Rickert - Simultaneous and individual ion addressing for qua.pdf:C\:\\Users\\webbd\\Zotero\\storage\\AKYQKCGM\\Rickert - Simultaneous and individual ion addressing for qua.pdf:application/pdf},
}

@misc{li_low-crosstalk_2023,
	title = {A low-crosstalk double-side addressing system using acousto-optic deflectors for atomic ion qubits},
	url = {http://arxiv.org/abs/2306.01307},
	abstract = {The ability to individually and agilely manipulate qubits is crucial for the scalable trapped-ion quantum information processing. A plethora of challenging proposals have been demonstrated with the utilization of optical addressing systems, in which single ions is addressed exclusively by individual laser beam. However, crosstalk error in optical addressing systems limits the gate fidelity, becoming an obstacle to quantum computing, especially quantum error correction. In this work, we demonstrate a low-crosstalk double-side addressing system based on a pair of acousto-optic deflectors (AODs). The AODs addressing method can flexibly and parallelly address arbitrary ions between which the distance is variable in a chain. We employ two 0.4{\textasciitilde}NA objective lenses in both arms of the Raman laser and obtain a beam waist of 0.95{\textasciitilde}\${\textbackslash}mu{\textbackslash}mathrm\{m\}\$, resulting in a Rabi rate crosstalk as low as \$6.32{\textbackslash}times10{\textasciicircum}\{-4\}\$ when the neighboring ion separation is about 5.5{\textasciitilde}\${\textbackslash}mu{\textbackslash}mathrm\{m\}\$. This agile and low-crosstalk double-side addressing system is promising for higher-fidelity gates and the practical application of the quantum error correction.},
	language = {en},
	urldate = {2023-07-03},
	publisher = {arXiv},
	author = {Li, Rui-Rui and Chen, Yi-Long and He, Ran and Chen, Shu-Qian and Qi, Wen-Hao and Cui, Jin-Ming and Huang, Yun-Feng and Li, Chuan-Feng and Guo, Guang-Can},
	month = jun,
	year = {2023},
	note = {arXiv:2306.01307 [quant-ph]},
	keywords = {Quantum Physics},
	file = {Li et al. - 2023 - A low-crosstalk double-side addressing system usin.pdf:C\:\\Users\\webbd\\Zotero\\storage\\8TU6REXZ\\Li et al. - 2023 - A low-crosstalk double-side addressing system usin.pdf:application/pdf},
}

