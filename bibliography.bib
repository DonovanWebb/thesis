@incollection{nagourney_mode-locked_2014,
	title = {Mode-locked lasers and frequency metrology},
	isbn = {978-0-19-966548-8},
	url = {https://doi.org/10.1093/acprof:oso/9780199665488.003.0011},
	abstract = {This chapter presents the theory of mode-locked lasers, describes a common implementation (the mode-locked Ti–sapphire laser), and discusses the application of these lasers in frequency metrology (using femtosecond combs). The model of a laser cavity provided with an intracavity shutter is used to describe all mode-locking techniques – the production of short pulses when the shutter is synchronized to the round-trip time of the intracavity fields. Techniques for obtaining the narrowest pulses by reducing the dispersion of the cavity media are discussed. The offset frequency in the mode-locked laser spectrum due to the “carrier-envelope slippage” is discussed, and techniques to control it are described. In addition, comb generation using four-wave mixing in a micro-resonator is discussed.},
	urldate = {2023-08-25},
